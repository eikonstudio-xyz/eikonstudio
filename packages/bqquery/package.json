{
  "name": "@eikonstudio/bqquery",
  "version": "0.1.0",
  "description": "Tiny, type-safe BigQuery query helpers with great DX",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "dev": "tsup --watch",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eikonstudio-xyz/eikonstudio.git",
    "directory": "packages/bqquery"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1"
  }
}
